# Leave X_BEARER_TOKEN empty for the simulated X. CHAIN=sim (default) simulates trades and payouts.
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Postgres. Empty = embedded PGlite in api/.data (dev only).
DATABASE_URL=
# X API v2 (pay-per-use). https://docs.x.com
X_BEARER_TOKEN=
# "tweet" or "post" field naming, see docs/decisions.md Test C
X_FIELD_STYLE=tweet
# Whisper-compatible /v1/audio/transcriptions endpoint for video bounties
WHISPER_URL=
WHISPER_API_KEY=
# Main verifier ed25519 secret key (base58). Never commit a real one.
VERIFIER_SECRET_KEY=
# Comma-separated base58 public keys of the 3 verifiers (main, backup, admin)
VERIFIER_ALLOWED_SIGNERS=
ADMIN_KEY=
SOL_USD=150
# Privy (https://dashboard.privy.io): same App ID as the web app + the App Secret (server only!)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Path 1: give targets a Privy wallet tied to their X account at payout. Turn on after Test A passes.
PRIVY_PREGENERATE=false
# ---- Real Solana (npm run chain:setup -w api fills these in) ----
# CHAIN=solana
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# DBC_CONFIG=
# KEEPER_SECRET_KEY=
# ESCROW_ADMIN_SECRET_KEY=
# VERIFIER_BACKUP_SECRET_KEY=
# Public URL of this API (token metadata links are written on-chain at launch)
# PUBLIC_API_URL=http://localhost:4000
# KEEPER_EVERY_SEC=60
# KEEPER_MIN_CLAIM_LAMPORTS=1000000
# Dev helpers (/api/dev/*). On by default with the simulated X. Never on a public deployment.
# DEV_TOOLS=true
